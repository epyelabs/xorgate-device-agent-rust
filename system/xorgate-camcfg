#!/bin/sh
# Installed by xorgate-rs at /usr/local/bin/xorgate-camcfg (provision-rs.sh,
# install-rs.sh, `xorgate-rs update`). Invoked by the Rust device agent via
# `sudo -n` (sudoers drop-in 025_xorgate-camcfg). It is the CAMERA-LINE OWNER:
# the one writer of the camera `dtoverlay=` lines in the boot config
# (support-other-camera-models plan; the policy lives in the agent, see
# crates/xorgate-core/src/boot_config.rs and
# crates/xorgate-agent/src/ops/camera_mount.rs).
#
# The agent runs unprivileged and /boot/firmware is root-owned, so this helper
# is the entire sudo surface of the feature. EVERY ARGUMENT IS TREATED AS
# HOSTILE: the sudoers entry cannot constrain argument values, so nothing the
# caller passes is ever written as given. The helper builds a line itself from
# checked parts, and it only ever touches camera lines of ONE port.
#
#   usage: xorgate-camcfg rotate <cam0|cam1> <overlay> <0|180>
#          xorgate-camcfg set    <cam0|cam1> <overlay> [param...] rotation=<0|180>
#          xorgate-camcfg remove <cam0|cam1>
#
#   rotate  On the port's ONE camera line, which must name <overlay>, set the
#           `rotation=` token and change nothing else: every other token is
#           kept verbatim and in order. An existing token is replaced where it
#           stands; without one it is appended. <overlay> need not be in the
#           allow-list (it is never written, only compared).
#   set     Make the port's camera line
#             dtoverlay=<overlay>,<port>[,<param>...],rotation=<deg>
#           Replaces the port's line (the LAST one when several exist; the
#           others are deleted, so a sensor swap cannot leave two lines on one
#           port) or, when the port has none, appends it under `[all]`. Also
#           turns an uncommented `camera_auto_detect=<not 0>` into
#           `camera_auto_detect=0`. <overlay> must be in the allow-list,
#           overlays/<overlay>.dtbo must exist, and every <param> must be
#           `<name>=<value>` or `<name>` with a NAME the allow-list gives that
#           overlay, at most once each. `cam0`, `cam1` and `rotation` in any
#           form are never taken as a parameter: this helper writes them.
#   remove  Delete the port's camera line(s).
#
#   exit 0  the file was changed
#   exit 3  already as asked: nothing written
#   exit 4  rotate: the port has no camera line
#   exit 5  refused: config.txt is in a state this helper does not edit (see
#           "WHAT IT REFUSES"); nothing written
#   exit 2  bad arguments, or no config.txt / allow-list / overlay file
#   exit 1  the write itself failed
#
# WHICH LINE IS A PORT'S CAMERA LINE
#   An uncommented `dtoverlay=<name>,...` line (leading whitespace allowed) is
#   a camera line of a port when:
#   - <name> is in the allow-list (xorgate-camcfg.overlays, beside this file,
#     generated from the agent's sensor catalog): with a `cam0` parameter it
#     is CAM0's; WITHOUT one it is CAM1's, with or without a `cam1` token
#     (`cam0` is the only real port selector of a camera overlay);
#   - <name> is NOT in the allow-list: only with an explicit port token,
#     `cam0` for CAM0, or `cam1` and no `cam0` for CAM1. (`dtoverlay=vc4-kms-v3d`
#     has no `cam0` either: without a token nothing says the line is a
#     camera's, so it is nobody's.)
#
# WHICH [section] FILTERS APPLY TO THIS BOARD
#   The board is read from /proc/device-tree/model.
#   - no header yet, or [all]: applies (and [all] clears every filter)
#   - [cm4], [pi4]: applies on a Compute Module 4, does not on a Compute
#     Module 5, unknown on any other board
#   - [cm5], [pi5]: applies on a Compute Module 5, does not on a Compute
#     Module 4, unknown on any other board
#   - anything else ([none], [pi3], [cm4s], [gpio4=1], [EDID=...], [tryboot],
#     a serial number, ...): unknown, and it stays unknown until the next [all]
#   A camera line under a filter that does NOT apply is not the port's line:
#   it is never counted and never touched. A camera line under an UNKNOWN
#   filter may or may not apply, so the helper refuses to edit the port.
#
# THE ALLOW-LIST (xorgate-camcfg.overlays, root-owned, beside this file)
#   One camera overlay per line: its name, then the parameter NAMES `set` may
#   write for it, separated by spaces. `#` starts a comment line. Generated
#   from the agent's sensor catalog (each sensor's fixed parameters and
#   options), never edited by hand:
#       imx290 clock-frequency
#       imx219
#
# WHAT IT REFUSES (exit 5)
#   - rotate: several camera lines for the port; a line that names another
#     overlay than the one asked for; a line holding a token outside the
#     strict charset (it could not be written back unchanged);
#   - any verb: a camera line of the port under a filter it cannot evaluate;
#   - set (when it puts ANOTHER overlay on the line, or deletes a second
#     line) and remove: a camera line that is followed by a `dtparam=` line.
#     A `dtparam=` applies to the overlay loaded before it, so it would then
#     apply to another overlay. "Followed" = the next line that is not
#     blank, not a comment and not a [section] header;
#   - a resulting line longer than 98 characters (the firmware's limit).
#
# THIS SCRIPT NEVER REBOOTS. A camera line is a device-tree matter, so a
# change applies on the next boot; deciding when that happens is a human's
# call (the cloud shows "reboot required"). It never touches a line that is
# not a camera line of the port it was asked about (`set` also fixes
# `camera_auto_detect`), keeps one backup of the file as it was before its
# first edit (config.txt.bak-camcfg, written whole or not at all, never
# overwritten; no backup, no edit) and replaces the file by a rename, never
# in place. Before the rename it checks that only camera lines differ.
set -eu
# No pathname expansion anywhere but the one sweep below that asks for it.
set -f
# A signal ends the run where it stands, with nothing written: the config is
# only ever replaced by the one rename at the very end (and the EXIT trap set
# further down removes the temp files).
trap 'exit 1' INT TERM
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL
umask 022
# The default field separators (space, tab, newline), whatever was inherited.
IFS=$(printf ' \t\n_')
IFS=${IFS%_}

# Every message goes through printf '%s\n': text that comes from config.txt
# (a section name, an overlay name) must never be escape-processed on its way
# to the caller (dash's `echo` expands backslashes).
say() { printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }

usage() {
  err "usage: xorgate-camcfg rotate <cam0|cam1> <overlay> <0|180> | set <cam0|cam1> <overlay> [param...] rotation=<0|180> | remove <cam0|cam1>"
  exit 2
}

# An overlay or parameter NAME: [a-z0-9][a-z0-9_-]*, at most 32 characters.
valid_name() {
  case "$1" in
    '' | *[!a-z0-9_-]* | [_-]* ) return 1 ;;
  esac
  [ "${#1}" -le 32 ]
}
# One overlay parameter: a name, optionally `=` and a value of
# [A-Za-z0-9_.+-], 1 to 32 characters. No comma, space, quote, `#`, `[` or
# newline can pass: nothing that could start another token, line or section.
valid_param() {
  case "$1" in
    *=* )
      valid_name "${1%%=*}" || return 1
      pv=${1#*=}
      case "$pv" in
        '' | *[!A-Za-z0-9_.+-]* ) return 1 ;;
      esac
      [ "${#pv}" -le 32 ]
      ;;
    * ) valid_name "$1" ;;
  esac
}

verb="${1:-}"
port="${2:-}"
case "$verb" in
  rotate | set | remove ) ;;
  * ) usage ;;
esac
case "$port" in
  cam0 | cam1 ) ;;
  * ) usage ;;
esac

overlay=""
deg=""
params=""
pnames=" "
case "$verb" in
  rotate )
    [ "$#" -eq 4 ] || usage
    overlay="$3"
    deg="$4"
    valid_name "$overlay" || usage
    case "$deg" in
      0 | 180 ) ;;
      * ) usage ;;
    esac
    ;;
  set )
    [ "$#" -ge 4 ] || usage
    overlay="$3"
    valid_name "$overlay" || usage
    shift 3
    # The LAST argument is the rotation; everything before it is a parameter.
    while [ "$#" -gt 1 ]; do
      valid_param "$1" || usage
      pn=${1%%=*}
      case "$pn" in
        cam0 | cam1 | rotation* ) usage ;;   # written by this helper, never taken, in any form
      esac
      case "$pnames" in
        *" $pn "* ) usage ;;                 # one value per parameter
      esac
      pnames="$pnames$pn "
      params="$params,$1"
      shift
    done
    case "$1" in
      rotation=0 ) deg=0 ;;
      rotation=180 ) deg=180 ;;
      * ) usage ;;
    esac
    ;;
  remove )
    [ "$#" -eq 2 ] || usage
    ;;
esac

# TEST-ONLY seams (the test suite drives this script against fixture files).
# They are honoured only when the script was NOT started through sudo: sudo
# resets the environment and always sets SUDO_UID, so under sudo the real
# paths are used whatever the caller's environment holds.
config=""
list=/usr/local/bin/xorgate-camcfg.overlays
model=/proc/device-tree/model
lock=/run/xorgate-camcfg.lock
seams=0
if [ -z "${SUDO_UID:-}" ]; then
  if [ -n "${XORGATE_BOOT_CONFIG:-}" ]; then config=$XORGATE_BOOT_CONFIG; seams=1; fi
  if [ -n "${XORGATE_CAMCFG_OVERLAYS:-}" ]; then list=$XORGATE_CAMCFG_OVERLAYS; seams=1; fi
  if [ -n "${XORGATE_CAMCFG_MODEL:-}" ]; then model=$XORGATE_CAMCFG_MODEL; seams=1; fi
  if [ -n "${XORGATE_CAMCFG_LOCK:-}" ]; then lock=$XORGATE_CAMCFG_LOCK; seams=1; fi
fi
if [ -z "$config" ]; then
  config=/boot/firmware/config.txt
  [ -f "$config" ] || config=/boot/config.txt
fi
if [ ! -f "$config" ] || [ -L "$config" ]; then
  err "no config.txt found (looked in /boot/firmware and /boot)"
  exit 2
fi

# The allow-list (format in the header). Root-owned and not writable by
# anyone else, or it is not trusted.
if [ ! -f "$list" ] || [ -L "$list" ]; then
  err "no overlay allow-list at $list: run \`sudo xorgate-rs update\`"
  exit 2
fi
if [ "$seams" = 0 ]; then
  case "$(stat -c '%u %a' "$list" 2>/dev/null || echo '? ?')" in
    '0 644' | '0 444' | '0 640' | '0 600' | '0 400' | '0 440' ) ;;
    * )
      err "the overlay allow-list $list is not a root-owned, root-only-writable file"
      exit 2
      ;;
  esac
fi
allow=" "    # " <overlay> <overlay> "
pallow=" "   # " <overlay>:<param name> <overlay>:<param name> "
while IFS= read -r entry || [ -n "$entry" ]; do
  case "$entry" in
    '' | '#'* ) continue ;;
  esac
  ov=""
  for w in $entry; do
    if ! valid_name "$w"; then
      err "the overlay allow-list $list holds a bad entry"
      exit 2
    fi
    if [ -z "$ov" ]; then
      ov=$w
      allow="$allow$ov "
    else
      case "$w" in
        cam0 | cam1 | rotation* )
          err "the overlay allow-list $list holds a bad entry"
          exit 2
          ;;
      esac
      pallow="$pallow$ov:$w "
    fi
  done
done < "$list"

if [ "$verb" = set ]; then
  case "$allow" in
    *" $overlay "* ) ;;
    * )
      err "the overlay $overlay is not in the allow-list $list"
      exit 2
      ;;
  esac
  for pn in $pnames; do
    case "$pallow" in
      *" $overlay:$pn "* ) ;;
      * )
        err "the overlay $overlay takes no parameter $pn in the allow-list $list"
        exit 2
        ;;
    esac
  done
  dtbo="$(dirname -- "$config")/overlays/$overlay.dtbo"
  if [ ! -f "$dtbo" ]; then
    err "no overlay file $dtbo on this device"
    exit 2
  fi
  target="dtoverlay=$overlay,$port$params,rotation=$deg"
  if [ "${#target}" -gt 98 ]; then
    err "the line would be ${#target} characters; the firmware reads at most 98"
    exit 2
  fi
fi

# The board, for the [section] filters.
board=unknown
if [ -r "$model" ]; then
  case "$(tr -d '\000' < "$model" 2>/dev/null || true)" in
    "Raspberry Pi Compute Module 4 Rev"* ) board=cm4 ;;
    "Raspberry Pi Compute Module 5 Rev"* | "Raspberry Pi Compute Module 5 Lite Rev"* ) board=cm5 ;;
  esac
fi

# One writer at a time (two reconcile passes may overlap). Best effort: a
# device without flock(1) runs unlocked, as xorgate-camrotate always did.
# The lock file is root-only (0600): flock(2) works on a read-only
# descriptor, so a file others could open would let any account hold it.
if command -v flock >/dev/null 2>&1; then
  if ( umask 077; : >> "$lock" ) 2>/dev/null; then
    chmod 600 "$lock" 2>/dev/null || true
    exec 9>> "$lock"
    flock -w 15 9 || { err "another xorgate-camcfg is still running"; exit 1; }
  fi
fi

# Does the file end without a newline? (Kept that way unless a line is added.)
nofinalnl=0
if [ -s "$config" ] && [ -n "$(tail -c 1 "$config")" ]; then nofinalnl=1; fi

# Temp files a killed run (or a power cut) left beside the config: ours by
# name, never read by the firmware, removed before a new one is made.
set +f
rm -f "$config".xorgate-camcfg.[0-9]* 2>/dev/null || true
set -f

tmp="$config.xorgate-camcfg.$$"
trap 'rm -f "$tmp" "$tmp.verdict" "$tmp.diff" "$tmp.old" "$tmp.new" "$tmp.bak"' EXIT

# One awk pass (POSIX awk; the devices run mawk). It reads the whole file,
# decides, and prints the new file on stdout and ONE verdict line on stderr:
#   CHANGED <lines printed> <message> | SAME | NOLINE | REFUSED <message>
# Every line that is not touched is printed byte for byte (a CR included).
rc=0
awk -v verb="$verb" -v port="$port" -v overlay="$overlay" -v deg="$deg" \
    -v params="$params" -v allow="$allow" -v board="$board" -v nofinalnl="$nofinalnl" '
  function trim(s) {
    sub(WS_HEAD, "", s); sub(WS_TAIL, "", s)
    return s
  }
  function valid_name(s) {
    return (length(s) >= 1 && length(s) <= 32 && s ~ /^[a-z0-9][a-z0-9_-]*$/)
  }
  function valid_token(s,    i, v) {
    i = index(s, "=")
    if (i == 0) return valid_name(s)
    v = substr(s, i + 1)
    return (valid_name(substr(s, 1, i - 1)) && length(v) >= 1 && length(v) <= 32 && v ~ /^[A-Za-z0-9_.+-]+$/)
  }
  # THE SECTION RULE (see the header of this file).
  function enter(name,    fam) {
    if (name == "all") { state = "A"; sticky = 0; return }
    if (sticky) return
    fam = ""
    if (name == "cm4" || name == "pi4") fam = "cm4"
    else if (name == "cm5" || name == "pi5") fam = "cm5"
    if (fam == "") { state = "U"; sticky = 1; return }
    if (board != "cm4" && board != "cm5") { state = "U"; return }
    state = (fam == board) ? "A" : "N"
  }
  function refuse(msg) {
    if (verdict == "") verdict = "REFUSED " msg
  }
  # Is line i followed by a `dtparam=` line? (The next line that is not
  # blank, not a comment and not a [section] header.) Such a line applies to
  # the overlay loaded before it.
  function dtparam_follows(i,    j, t) {
    for (j = i + 1; j <= n; j++) {
      t = text[j]
      if (t == "" || substr(t, 1, 1) == "#" || substr(t, 1, 1) == "[") continue
      return (substr(t, 1, 8) == "dtparam=")
    }
    return 0
  }
  function refuse_dtparam() {
    refuse("a dtparam= line follows the camera line of " port " and would then apply to another overlay; move it into the dtoverlay line or remove it first")
  }
  BEGIN {
    # Space, tab, CR, VT, FF: what may surround a token or a line.
    ws = "[ \t\r" sprintf("%c", 11) sprintf("%c", 12) "]"
    WS_HEAD = "^" ws "+"; WS_TAIL = ws "+$"
    state = "A"; sticky = 0; secname = ""
    n = 0; nc = 0; verdict = ""
  }
  {
    n++
    line[n] = $0
    cr[n] = ($0 ~ /\r$/) ? "\r" : ""
    t = trim($0)
    text[n] = t
    if (substr(t, 1, 1) == "[") {
      if (t ~ /^\[[^]]*\]$/) secname = substr(t, 2, length(t) - 2)
      else secname = t
      enter(secname)
      next
    }
    if (substr(t, 1, 19) == "camera_auto_detect=") {
      if (substr(t, 20) != "0") autodetect[n] = 1
      next
    }
    if (substr(t, 1, 10) != "dtoverlay=") next
    ntok = split(substr(t, 11), part, ",")
    k = 0; has0 = 0; has1 = 0; clean = 1; nrot = 0; rotv = ""
    for (i = 1; i <= ntok; i++) {
      x = trim(part[i])
      if (x == "") continue
      k++
      tok[n, k] = x
      if (k == 1) {
        if (!valid_name(x)) clean = 0
        continue
      }
      if (x == "cam0") has0 = 1
      if (x == "cam1") has1 = 1
      if (substr(x, 1, 9) == "rotation=") {
        nrot++
        if (nrot == 1) rotv = substr(x, 10)
      } else if (!valid_token(x)) clean = 0
    }
    if (k == 0) next
    if (index(allow, " " tok[n, 1] " ") > 0) mine = ((has0 ? "cam0" : "cam1") == port)
    else mine = (port == "cam0") ? has0 : (has1 && !has0)
    if (!mine || state == "N") next
    nc++
    cand[nc] = n
    ntoks[n] = k; cscope[n] = state; csec[n] = secname
    cclean[n] = clean; cnrot[n] = nrot; crot[n] = rotv
  }
  END {
    changed = 0; nadd = 0; msg = ""
    for (j = 1; j <= nc; j++) {
      i = cand[j]
      if (cscope[i] == "U")
        refuse("a camera line of " port " sits under [" csec[i] "], a section this helper cannot evaluate for this board; edit it by hand")
    }
    if (verdict == "" && verb == "rotate") {
      if (nc == 0) verdict = "NOLINE"
      else if (nc > 1) refuse(nc " camera lines configure " port "; remove the stale ones first")
      else {
        i = cand[1]
        if (tok[i, 1] != overlay) refuse("the camera line of " port " names " tok[i, 1] ", not " overlay)
        else if (!cclean[i]) refuse("the camera line of " port " holds characters this helper does not write back")
        else if (cnrot[i] == 1 && (crot[i] "") == (deg "")) verdict = "SAME"
        else {
          out = "dtoverlay=" tok[i, 1]; placed = 0
          for (k = 2; k <= ntoks[i]; k++) {
            x = tok[i, k]
            if (substr(x, 1, 9) == "rotation=") {
              if (!placed) { out = out ",rotation=" deg; placed = 1 }
              continue
            }
            out = out "," x
          }
          if (!placed) out = out ",rotation=" deg
          if (length(out) > 98) refuse("the line would be " length(out) " characters; the firmware reads at most 98")
          else { line[i] = out cr[i]; changed = 1; msg = out }
        }
      }
    }
    if (verdict == "" && verb == "set") {
      target = "dtoverlay=" overlay "," port params ",rotation=" deg
      msg = target
      for (i = 1; i <= n; i++) {
        if (i in autodetect) { line[i] = "camera_auto_detect=0" cr[i]; changed = 1 }
      }
      if (nc == 0) {
        if (state != "A") add[++nadd] = "[all]"
        add[++nadd] = target
        changed = 1
      } else {
        for (j = 1; j < nc; j++) {
          if (dtparam_follows(cand[j])) refuse_dtparam()
          drop[cand[j]] = 1; changed = 1
        }
        i = cand[nc]
        if (tok[i, 1] != overlay && dtparam_follows(i)) refuse_dtparam()
        if (text[i] != target) { line[i] = target cr[i]; changed = 1 }
      }
    }
    if (verdict == "" && verb == "remove") {
      for (j = 1; j <= nc; j++) {
        if (dtparam_follows(cand[j])) refuse_dtparam()
        drop[cand[j]] = 1; changed = 1
      }
      msg = "no camera line"
    }
    if (verdict == "" && !changed) verdict = "SAME"
    nout = 0
    for (i = 1; i <= n; i++) {
      if (i in drop) continue
      res[++nout] = line[i]
    }
    eol = (n > 0) ? cr[n] : ""
    for (j = 1; j <= nadd; j++) res[++nout] = add[j] eol
    for (i = 1; i <= nout; i++)
      printf "%s%s", res[i], ((i < nout || !nofinalnl || nadd > 0) ? "\n" : "")
    if (verdict == "") verdict = "CHANGED " nout " " msg
    print verdict > "/dev/stderr"
  }
' "$config" > "$tmp" 2> "$tmp.verdict" || rc=$?

verdict=$(cat "$tmp.verdict" 2>/dev/null || true)
rm -f "$tmp.verdict"
if [ "$rc" != 0 ]; then
  err "could not prepare the new $config (awk exit $rc)"
  exit 1
fi

case "$verdict" in
  SAME )
    exit 3
    ;;
  NOLINE )
    err "no camera dtoverlay line for $port in $config"
    exit 4
    ;;
  "REFUSED "* )
    err "${verdict#REFUSED } ($config not changed)"
    exit 5
    ;;
  "CHANGED "* ) ;;
  * )
    err "could not prepare the new $config (no verdict)"
    exit 1
    ;;
esac
rest=${verdict#CHANGED }
want_lines=${rest%% *}
what=${rest#* }

# Before the new file replaces the old one, check it is what was meant. Any
# doubt, a missing tool included, leaves the old file in place.
# 1. The line count awk reported.
have_lines=$(awk 'END { print NR }' "$tmp")
if [ "$have_lines" != "$want_lines" ]; then
  err "the new $config is incomplete ($have_lines of $want_lines lines); not written"
  exit 1
fi
# 2. Every line that differs from the old file is a camera matter
#    (`dtoverlay=`, `camera_auto_detect=`, the `[all]` this helper adds). Both
#    files are compared with their last line terminated, so the newline a
#    neighbouring line gains or loses is not a change of that line.
if ! command -v diff >/dev/null 2>&1; then
  err "cannot check the new $config (no diff on this device); not written"
  exit 1
fi
if ! awk '{ print }' "$config" > "$tmp.old" || ! awk '{ print }' "$tmp" > "$tmp.new"; then
  err "could not check the new $config; not written"
  exit 1
fi
drc=0
diff -a "$tmp.old" "$tmp.new" > "$tmp.diff" 2>/dev/null || drc=$?
case "$drc" in
  0 | 1 ) ;;
  * )
    err "could not check the new $config (diff exit $drc); not written"
    exit 1
    ;;
esac
grc=0
foreign=$(grep -vcE '^([0-9,]+[acd][0-9,]+|---|[<>] [[:space:]]*(dtoverlay=|camera_auto_detect=|\[all\]).*)$' "$tmp.diff") || grc=$?
case "$grc" in
  0 | 1 ) ;;
  * )
    err "could not check the new $config (grep exit $grc); not written"
    exit 1
    ;;
esac
if [ "$foreign" != 0 ]; then
  err "the new $config would change a line that is not a camera line; not written"
  exit 1
fi
rm -f "$tmp.diff" "$tmp.old" "$tmp.new"

# Keep one backup of the file as it was before this helper first edited it,
# and never overwrite it: the first edit is the one worth going back to. It
# is copied under a temp name, compared, flushed, and only then renamed, so
# a backup that exists is always whole. No backup, no edit.
if [ -f "$config.bak-camcfg" ] && [ ! -L "$config.bak-camcfg" ]; then
  : # the backup of the first edit is there
elif [ -e "$config.bak-camcfg" ] || [ -L "$config.bak-camcfg" ]; then
  err "$config.bak-camcfg is in the way (not a regular file): no backup can be kept; not written"
  exit 1
elif cp -p "$config" "$tmp.bak" 2>/dev/null && cmp -s "$config" "$tmp.bak" \
     && sync "$tmp.bak" 2>/dev/null && mv -f "$tmp.bak" "$config.bak-camcfg" 2>/dev/null; then
  :
else
  rm -f "$tmp.bak"
  err "could not keep a backup of $config beside it; not written"
  exit 1
fi

# /boot/firmware is FAT on a Pi, where rename is the only ordering primitive
# available: write a sibling temp file, flush it, and rename it over the
# target, so a power cut during the swap leaves either the old file or the
# new one, never a truncated config.txt on a device that then cannot boot.
chmod --reference="$config" "$tmp" 2>/dev/null || chmod 755 "$tmp"
if ! sync "$tmp" 2>/dev/null; then
  err "could not flush the new $config to disk; not written"
  exit 1
fi
mv -f "$tmp" "$config"
trap - EXIT
sync 2>/dev/null || true

say "$config: $port: $what (applies on next boot)"
exit 0
