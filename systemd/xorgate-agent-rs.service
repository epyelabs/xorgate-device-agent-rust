# xorgate device agent (Rust) systemd unit.
#
# This is the Rust port of xorgate-agent.service (device/xorgate-device-agent).
# It mirrors that unit line for line except where the Rust binary differs; keep
# the two in sync when the JS unit changes until cutover.
#
# Coexistence model (plans/device-agent-js-to-rust, README §6): a device is
# provisioned with the JS agent as today and later CONVERTED by install-rs.sh,
# which drops this build at /opt/xorgate-rs, installs this unit + the
# /usr/local/bin/xorgate-rs wrapper, and swaps the active unit:
#
#   install -m 0644 /opt/xorgate-rs/systemd/xorgate-agent-rs.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl disable --now xorgate-agent
#   systemctl enable --now xorgate-agent-rs
#
# Only ONE agent may own the device identity at a time: both connect with
# clientId = DEVICE_ID, and AWS IoT kicks the older session when a second one
# connects, so two agents on the same identity would fight forever. The
# `Conflicts=` below makes systemd stop xorgate-agent when this unit starts
# (and vice versa) — it is the belt to install-rs.sh's braces; `After=` below
# orders the two jobs. On the bench, scripts/bench/install.sh comments the
# `Conflicts=` line out of the INSTALLED copy (a drop-in cannot reset it: an
# empty `Conflicts=` is ignored on systemd 252), and the bench-only drop-in
# systemd/bench/90-bench-dev.conf points this unit at a SEPARATE dev identity +
# state dir, so Phase 0-5 can soak both agents on one CM5. Neither is shipped.
#
# Prerequisites on the host (all handled by install-rs.sh / the converter):
#   - The agent binary at /opt/xorgate-rs/bin/xorgate-rs (+ build-info.json).
#   - /etc/xorgate/agent.env with DEVICE_ID, IOT_DATA_ENDPOINT, CERT_PATH,
#     KEY_PATH, CA_PATH (and optionally MODE=sim|real) — the SAME file the JS
#     agent reads; nothing under /etc/xorgate changes at conversion.
#   - The cert/key files readable by the service user (chmod 0600).
#
# User=root here is the fallback. The converter re-uses the JS unit's
# `xorgate-agent.service.d/10-user.conf` (copied to this unit's .d/) that
# overrides it to run the agent as the provisioning user (captured from
# $SUDO_USER), so that operator can inspect it without sudo. The agent only
# needs an outbound mTLS connection, so it does not require root.
#
# XORGATE_HOME points at the StateDirectory (/var/lib/xorgate) — the same dir
# the JS agent used, so settings.json / config-sync.json / counters survive the
# conversion; systemd creates and chowns it to the (drop-in) service user. The
# `xorgate-rs` CLI wrapper defaults to the same path, so `xorgate-rs status`
# reflects THIS running service.
#
# Type=notify: the Rust agent calls sd_notify(READY=1) once its MQTT client is
# constructed and pings WATCHDOG=1 every second from its main loop REGARDLESS
# of MQTT state (a device booting without network keeps reconnecting under the
# watchdog, as the JS Type=simple unit does); NotifyAccess=main keeps
# child processes (python IMU reader, KVS runtime, ...) from satisfying the
# watchdog on the agent's behalf. A wedged main loop is restarted by systemd
# after WatchdogSec. Phase 0 keeps the watchdog generous (60 s); tune later.
#
# RGB status LED hooks (Phase 4 WP1, CF49) — the JS unit's two lines with the
# Rust wrapper. Both run as the drop-in service user (pi), not root, through
# `pinctrl` (no sudo) as separate processes: the agent itself drives the LED
# through the GPIO character device (consumer "xorgate-rs"), but it is not
# running when these fire, and pinctrl writes the registers directly anyway.
# `exit-state` reads $SERVICE_RESULT, which systemd sets for ExecStopPost:
# `success` (systemctl stop/restart, reboot — our SIGTERM path exits 0) blanks
# the LED; a crash (exit-code/signal/core-dump/watchdog/timeout) latches solid
# red. Both are prefixed `-` so the LED can NEVER stop the agent: without it,
# a non-zero ExecStartPre aborts the start entirely.
# The unit's environment (incl. a drop-in PATH) applies to both hooks, so the
# bench shared profile's `pinctrl` shim makes them harmless there.

[Unit]
Description=Xorgate device agent (Rust) (IoT MQTT telemetry)
After=network-online.target
Wants=network-online.target
# One identity, one agent: starting this unit stops the JS agent and vice
# versa (see header). Stripped from the bench's installed copy by
# scripts/bench/install.sh.
Conflicts=xorgate-agent.service
# O-P6-1 (Phase 6 window 1): Conflicts= alone puts no order between the two
# jobs, so a convert with JS ACTIVE started this unit IN PARALLEL with JS's
# stop (both alive ~0.47 s, the two MQTT sessions 61 ms from overlapping,
# JS's ExecStopPost LED blank skipped because we already held the GPIO lines).
# With any ordering dependency, systemd orders a stop job before a start job
# of the other unit (systemd.unit(5), Before=/After=: "if one unit is shut
# down and the other is started up, the shutdown is ordered before the
# start-up ... It doesn't matter if the ordering dependency is After= or
# Before="), in BOTH directions: JS (incl. its ExecStopPost) is fully stopped
# before we start, and a JS start that conflicts us out waits for our stop.
# At boot it is a no-op (only one of the two is enabled); on the bench, where
# both run, it only makes this unit start after JS's start job (Type=simple:
# immediate). Pinned by scripts/tests/unit-sections.sh.
After=xorgate-agent.service
# Break crash-loops: 10 failures in 60s and systemd holds off until the operator
# runs `systemctl reset-failed xorgate-agent-rs`. Both are [Unit] keys (O-P5G-1,
# user-approved 2026-11-06). Under [Service], systemd 252 (bookworm) logs
# "Unknown key 'StartLimitIntervalSec' in section [Service], ignoring." and
# uses the default 10 s window (only StartLimitBurst= is still accepted there,
# as a compat alias). Pinned by scripts/tests/unit-sections.sh.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=root
EnvironmentFile=/etc/xorgate/agent.env
# systemd creates/owns /var/lib/xorgate (persists across reboots); the worker
# writes its pidfile + state.json there.
StateDirectory=xorgate
StateDirectoryMode=0700
Environment=XORGATE_HOME=/var/lib/xorgate
# Run from the writable StateDirectory. The IMU reader's GPIO backend (lgpio,
# used by Adafruit Blinka on Pi 5) creates `.lgd-nfy*` notify files in the CWD;
# the default service CWD "/" isn't writable by the service user, which makes
# `import board` fail. /var/lib/xorgate is created + owned by the service user.
WorkingDirectory=/var/lib/xorgate
ExecStartPre=-/usr/local/bin/xorgate-rs led boot
ExecStart=/opt/xorgate-rs/bin/xorgate-rs run
ExecStopPost=-/usr/local/bin/xorgate-rs led exit-state

# Restart on every exit (including a clean exit 0 after SIGTERM). Recovers from
# a brief IoT/cert outage and from operator-induced stops.
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
