[Unit]
Description=Xorgate agent self-update (Rust) (fetch latest build, install, restart agent)
Documentation=https://github.com/epyelabs/xorgate-device-agent-rust

# The Rust port of xorgate-updater.service (device/xorgate-device-agent
# systemd/xorgate-updater.service @ 89b5c64), line for line except the unit
# names and TimeoutStartSec (below): it runs `xorgate-rs update`, never the JS
# updater (O3, README §6).
#
# Deliberately NO [Install] section: this unit is never enabled and never runs
# on boot. It is started on demand — by hand, or by the agent acting on a
# cloud-issued `update` command via
#   sudo -n systemctl start --no-block xorgate-updater-rs.service
# (exact-match sudoers grant, /etc/sudoers.d/024_xorgate-update-rs — the argv
# and that line come from ONE const, xorgate_core::update_plan::UPDATE_RS_ARGV).
#
# Why a unit at all, rather than the agent updating itself in-process or
# spawning `sudo xorgate-rs update` as a child:
#   - the agent runs unprivileged (User=pi drop-in); the updater needs root;
#   - a child process would sit in the agent's own cgroup and be killed by the
#     `systemctl restart xorgate-agent-rs` that the update itself performs.
# systemd owns the updater instead, so it survives the restart of its caller,
# and `systemctl start` on an already-activating oneshot coalesces into the
# running job — which is what makes a double-pressed Update button harmless.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/xorgate-rs update
# The default TimeoutStartSec (90s) would SIGTERM the updater in the middle of
# the download, which over LTE on a CM5 can take minutes (the JS unit sized this
# for `npm ci`; the Rust rail has no npm step but keeps the budget for the
# tarball fetch). `xorgate-rs update` rolls back on failure, but a kill mid-swap
# is a class of failure worth not having.
#
# 45 min, not the JS unit's 20 (a deliberate difference): after the update is
# complete, `xorgate-rs update` installs the extra OS packages a declared
# camera sensor needs (`xorgate-rs camera requirements --install`), which at
# its worst takes 22 min (two downloads, an apt simulation, and an `apt-get
# install` that is given 10 min and is NEVER cut short). The update gives the
# step only what is left of these 45 min less a margin, and that is what
# systemd says the LOADED unit's budget is, not what this file says
# (xorgate_core::update_plan::{updater_unit_budget, camera_packages_limit}; a
# test ties the number to this line); the step starts the install only when it
# can finish inside that.
TimeoutStartSec=45min
# What a stop of this unit does to a running `apt-get install` (also two
# deliberate differences from the JS unit, which has neither line). A stop is
# the start timeout above, a `systemctl stop`, or a shutdown / reboot.
#
# KillMode=mixed: the stop's SIGTERM goes to the MAIN process only (the
# updater), not to the whole control group as the default would: apt and dpkg
# are not signalled. But systemd SIGKILLs whatever is left of the unit the
# moment the main process is gone, so the updater must not die of that SIGTERM
# while the step runs: it passes the stop on to the step and waits for it. The
# step ends a download or a simulation at once, and finishes an `apt-get
# install` that has begun, with what follows it (hold, restart).
#
# TimeoutStopSec=15min: how long systemd waits for that before it kills what is
# left. An install and what follows it take at most 12.5 min (600 + 150 s;
# xorgate_core::update_plan::UPDATER_UNIT_STOP_SECS, a test ties it to this
# line). With nothing to protect the unit stops at once.
#
# Proven with a real systemd 252: scripts/tests/unit-ordering.sh, section G.
KillMode=mixed
TimeoutStopSec=15min
# `xorgate-rs update` reads /etc/xorgate/agent.env itself (for the dist bucket
# URL and version), so no EnvironmentFile is needed here. A runtime drop-in
# (`Environment=DEVICE_DIST_BUCKET_URL=…`) overrides it without editing the JS
# agent's agent.env (phase-4 E11).
