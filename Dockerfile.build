# Build image for the Rust agent — the SAME recipe CI uses (ubuntu-24.04-arm
# runner + `container: debian:bookworm`), so a Mac build links against exactly
# the GStreamer 1.22 / glibc 2.36 the CM5 runs. Driven by scripts/docker-build.sh;
# nothing in here is Mac-specific, it is just `debian:bookworm` + apt + rustup.
#
#   docker build --platform linux/arm64 -f Dockerfile.build \
#     --build-arg RUST_TOOLCHAIN=<channel from rust-toolchain.toml> -t xorgate-rs-build:<tag> .
#
# Keep the apt list in sync with .github/workflows/{ci,device-rs-deploy-*}.yml.
FROM --platform=linux/arm64 debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates pkg-config git \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libssl-dev lld \
 && rm -rf /var/lib/apt/lists/*

# rustup with NO default toolchain: the pinned one below is installed
# explicitly, and rust-toolchain.toml in the mounted repo still governs at
# run time (rustup proxies honor it; a mismatch just downloads the pin).
ARG RUST_TOOLCHAIN=stable
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal --default-toolchain none \
 && rustup toolchain install "$RUST_TOOLCHAIN" --profile minimal --component rustfmt,clippy \
 && rustup default "$RUST_TOOLCHAIN" \
 && rustc -V && cargo -V && pkg-config --modversion gstreamer-1.0

# Bind-mounted git checkouts are owned by a different uid than root-in-container.
RUN git config --global --add safe.directory '*'

WORKDIR /src
CMD ["cargo", "build", "--release"]
