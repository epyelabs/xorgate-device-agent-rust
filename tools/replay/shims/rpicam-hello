#!/bin/sh
# Rig shim: rpicam-hello. Answers `--list-cameras` from the tape's `exec`
# record (argv ["rpicam-hello","--list-cameras"]; the player writes
# $RIG_STATE/exec/rpicam-hello__--list-cameras.{out,err,code}, the same per-argv
# files as vcgencmd; `.err` = the tape's stderr, e.g. the zero-camera
# `No cameras available!`, review-wp5 S1). Put on PATH when the tape carries such a record or with
# `play --with-rpicam`; otherwise ABSENT ("cannot enumerate", the Phase 2
# default). No tape answer: "No cameras available!" exit 255 (the zero-camera
# branch, the pre-Phase-3 shim's only answer).
key="rpicam-hello__$(printf '%s' "$*" | tr ' /' '__')"
f="$RIG_STATE/exec/$key"
if [ -f "$f.out" ]; then
  cat "$f.out"
  [ -s "$f.err" ] && cat "$f.err" >&2
  exit "$(cat "$f.code" 2>/dev/null || echo 0)"
fi
echo "No cameras available!"
exit 255
