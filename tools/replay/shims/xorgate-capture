#!/usr/bin/env python3
# Rig shim: xorgate-capture (phase-7a-inprocess-gstreamer.md §Design 10, WP3).
# The Rust agent reaches it through XORGATE_CAPTURE_HOST_BIN (the player sets
# it to <work>/bin/xorgate-capture for a side whose env says
# XORGATE_CAPTURE_BACKEND=host). It behaves like the gst-launch-1.0 shim:
#
# - logs its argv VERBATIM to <work>/shim.ndjson (`tool: "xorgate-capture"`;
#   argv[0] is `__capture-host`, then the unchanged gst-launch tokens) — this
#   file lives in <work>/bin, so no env var is needed;
# - replaces ONLY `libcamerasrc camera-name=<cam>` with `videotestsrc
#   is-live=true pattern=ball` (real x264enc + splitmuxsink + shmsink, so the
#   ~2 s GOP lag the host measures is real);
# - tees stdout/stderr through a detached grandchild that stamps every line
#   with ITS OWN wall clock (`w`, read when the line arrived): the rig's
#   ground-truth timing checker takes the PLAYING instant from this teed
#   `New clock:` line, independently of the host's own stamps;
# - execs the REAL capture host, keeping this pid (so the agent's child pid,
#   the shmpipe.<pid>.* segments and the log agree), with argv[0] =
#   `xorgate-capture` as the agent gave it.
#
# The real host is the agent binary itself (the host is a hidden subcommand
# of it): RIG_REAL_HOST if set, else /proc/<parent>/exe — the shim's parent IS
# the Rust agent that spawned it (an exec wrapper keeps the pid). A parent
# that is not an xorgate-rs binary is refused (exit 127, logged), so the shim
# can never run some other program by accident.
import json, os, select, sys, time

WORK = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOG = os.path.join(WORK, "shim.ndjson")
NAME = "xorgate-capture"


def log(rec):
    rec["w"] = int(time.time() * 1000)
    line = json.dumps(rec, separators=(",", ":")) + "\n"
    fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, line.encode())
    finally:
        os.close(fd)


def real_host():
    env = os.environ.get("RIG_REAL_HOST", "").strip()
    if env:
        return env
    try:
        return os.readlink("/proc/%d/exe" % os.getppid())
    except OSError:
        return ""


def swap_source(argv):
    out = []
    i = 0
    while i < len(argv):
        if argv[i] == "libcamerasrc" and i + 1 < len(argv) and argv[i + 1].startswith("camera-name="):
            out += ["videotestsrc", "is-live=true", "pattern=ball"]
            i += 2
            continue
        out.append(argv[i])
        i += 1
    return out


def main():
    argv = sys.argv[1:]
    out = swap_source(argv)
    pid = os.getpid()
    real = real_host()
    base = os.path.basename(real)
    if not real or not (base.startswith("xorgate-rs") or os.environ.get("RIG_REAL_HOST")):
        log({"k": "spawn", "tool": NAME, "pid": pid, "argv": argv, "exec": out, "real": real, "refused": True})
        sys.stderr.write("xorgate-capture shim: parent %r is not an xorgate-rs binary\n" % real)
        os._exit(127)
    log({"k": "spawn", "tool": NAME, "pid": pid, "argv": argv, "exec": out, "real": real})

    r1, w1 = os.pipe()
    r2, w2 = os.pipe()
    child = os.fork()
    if child == 0:
        # Intermediate child: fork the tee and exit, so the tee is reparented
        # to the rig's init instead of lingering under the host.
        if os.fork() != 0:
            os._exit(0)
        # Own session: the player's end-of-run killpg of the AGENT's group must
        # not cut the tee before it logged the host's last lines + `eof`.
        os.setsid()
        os.close(w1)
        os.close(w2)
        bufs = {r1: b"", r2: b""}
        dst = {r1: 1, r2: 2}
        open_fds = [r1, r2]
        while open_fds:
            ready, _, _ = select.select(open_fds, [], [])
            for r in ready:
                chunk = os.read(r, 65536)
                if not chunk:
                    open_fds.remove(r)
                    if bufs[r]:
                        log({"k": "line", "pid": pid, "fd": dst[r], "line": bufs[r].decode("utf-8", "replace")})
                    continue
                try:
                    os.write(dst[r], chunk)
                except OSError:
                    pass
                bufs[r] += chunk
                while b"\n" in bufs[r]:
                    line, bufs[r] = bufs[r].split(b"\n", 1)
                    log({"k": "line", "pid": pid, "fd": dst[r], "line": line.decode("utf-8", "replace")})
        log({"k": "eof", "pid": pid})
        os._exit(0)
    os.waitpid(child, 0)
    os.close(r1)
    os.close(r2)
    os.dup2(w1, 1)
    os.dup2(w2, 2)
    os.close(w1)
    os.close(w2)
    os.execv(real, [NAME] + out)


if __name__ == "__main__":
    main()
